# SOEMS Global Environment Configuration Template

# ==========================================
# BACKEND CONFIGURATION
# ==========================================
PORT=5001
NODE_ENV=development

# Database
MONGO_USER=admin
MONGO_PASS=your_strong_password_here
MONGO_URI=mongodb://${MONGO_USER}:${MONGO_PASS}@mongo:27017/soems?authSource=admin

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# AI Configuration (NEW)
# Options: ollama, openai, gemini
AI_PROVIDER=ollama
# For Docker, use service name (ollama):
OLLAMA_URL=http://ollama:11434
# Default model to pull/use:
AI_MODEL=llama3

# Provider Keys (if using external providers)
OPENAI_API_KEY=sk-xxxx
GEMINI_API_KEY=xxxx

# Client Configuration (CORS)
FRONTEND_URL=http://localhost:5173

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
# For local development:
VITE_API_URL=http://localhost:5001
VITE_SOCKET_URL=http://localhost:5001

# For production (Docker/Nginx):
# VITE_API_URL=/api
# VITE_SOCKET_URL=
